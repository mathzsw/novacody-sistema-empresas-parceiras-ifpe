<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Cadastrar Administrador</title>
    <link rel="icon" type="image/x-icon" href="/img/iconelogin.png">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="form-container">

        <a href="/loginadmin" class="voltar">
            ← Voltar
        </a>

        <div class="form-box">

            <h1>Novo Administrador</h1>

            <p>
                Preencha os dados do novo administrador do sistema.
            </p>

        </div>

        <div class="form-box">

            <form action="/usuarios" method="POST">

                <label for="campo-nome">Nome</label>

                <input
                    type="text"
                    name="nome"
                    id="campo-nome"
                    autocomplete="name"
                    required
                >

                <label for="campo-Email">Email</label>

                <input
                    type="email"
                    name="email"
                    id="campo-Email"
                    autocomplete="email"
                    required
                >

                <label for="campo-senha">Senha</label>

                <input
                    type="password"
                    name="senha"
                    id="campo-senha"
                    autocomplete="new-password"
                    required
                >

                <label for="campo-tipo">Tipo</label>

                <input
                    type="text"
                    name="tipo"
                    id="campo-tipo"
                    required
                >

                <div class="botoes-form">

                    <a href="/loginadmin" class="btn-cancelar">
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn-salvar">
                        Cadastrar
                    </button>

                </div>

            </form>

        </main>

    </main>

</body>
</html>
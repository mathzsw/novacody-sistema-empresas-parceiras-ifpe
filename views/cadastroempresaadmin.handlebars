<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Cadastro Empresa</title>
    <link rel="icon" type="image/x-icon" href="/img/iconelogin.png">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="form-container">

        <a href="/area-admin" class="voltaradm">
            ← Voltar
        </a>

        <div class="form-box">

            <h1>Cadastro de Empresa Parceira</h1>

            <p>
                Preencha os Dados da Empresa para Parceria com o IFPE
            </p>

            <form action="/empresa/admin" method="POST">

                <label for="campo-Nome-Empresa">Nome da Empresa/Projeto *</label>
                <input
                    type="text"
                    name="nome"
                    id="campo-Nome-Empresa"
                >

                <label for="campo-CNPJ">CNPJ *</label>
                <input
                    type="text"
                    name="cnpj"
                    id="campo-CNPJ"
                >

                <label for="campo-E-mail">E-mail *</label>
                <input
                    type="text"
                    name="email"
                    id="campo-E-mail"
                >

                <label for="campo-Telefone">Telefone *</label>
                <input
                    type="text"
                    name="telefone"
                    id="campo-Telefone"
                >

                <label for="campo-Contato">Pessoa do Contato *</label>
                <input
                    type="text"
                    name="contato"
                    id="campo-Contato"
                >

                <label for="campo-Endereco">Endereço *</label>
                <input
                    type="text"
                    name="endereco"
                    id="campo-Endereco"
                >

                <br>

                <h2>Informações de Parceria</h2>

                <label for="campo-Tipo-Parceria">Tipo de Parceria *</label>
                <input
                    type="text"
                    name="tipo_parceria"
                    id="campo-Tipo-Parceria"
                >

                <label for="campo-Website">Website</label>
                <input
                    type="text"
                    name="website"
                    id="campo-Website"
                >

                <label for="campo-Vagas">Vagas Disponíveis</label>
                <input
                    type="number"
                    name="quantidade_vagas"
                    id="campo-Vagas"
                >

                <div class="checkbox-area">

                    <input
                        type="checkbox"
                        name="aceita_estagiario"
                        id="campo-Aceita-Estagiarios"
                    >

                    <label for="campo-Aceita-Estagiarios">Aceita Estagiários</label>

                </div>

                <label for="campo-Observacoes">Observações</label>

                <textarea name="observacoes" id="campo-Observacoes"></textarea>

                <div class="botoes">

                    <a href="/" class="btn-cancelar">
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn-cadastro"
                    >
                        Cadastrar Empresa
                    </button>

                </div>

            </form>

        </div>

    </main>

</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Solicitar Cadastro</title>
    <link rel="icon" type="image/x-icon" href="/img/iconelogin.png">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="form-container">

        <a href="/" class="voltar">
            ← Voltar
        </a>

        <div class="form-box">
            <h1>Solicitação de Cadastro</h1>

            <p>
                Preencha o formulário abaixo para solicitar o cadastro da sua empresa
                como parceira do IFPE. Após o envio, sua solicitação será analisada
                pela equipe administrativa.
            </p>
        </div>

        <div class="form-box">

            <h2>Solicitar Cadastro de Empresa Parceira</h2>

            <p>
                Preencha os Dados da Empresa para Parceria com o IFPE
            </p>

            <form action="/empresa" method="POST">

                
                <label for="campo-Nome-Empresa">Nome da Empresa/Projeto *</label>
                <input type="text" name="nome" id="campo-Nome-Empresa" autocomplete="organization">

                <label for="campo-CNPJ">CNPJ *</label>
                <input type="text" name="cnpj" id="campo-CNPJ">

                <label for="campo-Email">E-mail *</label>
                <input type="email" name="email" id="campo-Email" autocomplete="email">

                <label for="campo-Telefone">Telefone *</label>
                <input type="tel" name="telefone" id="campo-Telefone" autocomplete="tel">

                <label for="campo-Contato">Pessoa do Contato *</label>
                <input type="text" name="contato" id="campo-Contato" autocomplete="name">

                <label for="campo-Endereco">Endereço *</label>
                <input type="text" name="endereco" id="campo-Endereco" autocomplete="street-address">

                <br>

                <h3>Informações de Parceria</h3>

                <label for="campo-Tipo-Parceria">Tipo de Parceria *</label>
                <input type="text" name="tipo_parceria" id="campo-Tipo-Parceria">

                <label for="campo-Website"  >Website</label>
                <input
                    type="url"
                    name="website"
                    id="campo-Website"
                    autocomplete="url"
                >

                <label for="campo-Vagas"    >Vagas Disponíveis</label>
                <input type="number" name="quantidade_vagas" id="campo-Vagas" min="0">

                <div class="checkbox-area">
                    <input type="checkbox" name="aceita_estagiario" id="campo-Aceita-Estagiarios">
                    <label for="campo-Aceita-Estagiarios">Aceita Estagiários</label>
                </div>

                <label for="campo-Observacoes">Observações</label>
                <textarea name="observacoes" id="campo-Observacoes"></textarea>

                <div class="botoes">
                    <a href="/" class="btn-cancelar">
                        Cancelar
                    </a>

                    <button type="submit" class="btn-cadastro">
                        Solicitar Cadastro
                    </button>
                </div>

            </form>

        </div>

    </main>

</body>
</html>
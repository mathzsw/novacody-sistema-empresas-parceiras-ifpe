<!DOCTYPE html>
<html lang="pt-br">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Empresas Pendentes</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
  <main class="admin-container">
    <div class="topo-admin">
      <div><h1>Painel Administrativo</h1><p class="admin-subtitulo">Bem-vindo(a), {{usuarioLogado.nome}}</p></div>
      <form action="/logout" method="POST"><button class="btn-cancelar" type="submit">Sair</button></form>
    </div>
    <hr class="linha-admin">
    <div class="acoes-admin">
      <a href="/cadastroempresaadmin" class="btn-admin-topo">Cadastrar Empresa</a>
      <a href="/usuarios" class="btn-admin-topo">Administradores</a>
      <a href="/representantes" class="btn-admin-topo">Representantes</a>
    </div>
    <hr class="linha-admin">
    <div class="tabs-admin">
      <a href="/area-admin/pendentes" class="tab-admin ativa">Pendentes</a>
      <a href="/area-admin/aprovadas" class="tab-admin">Aprovadas</a>
    </div>
    <section class="admin-section">
      <h2>Empresas Pendentes</h2>
      <p class="contador-admin">{{pendentes.length}} empresa(s) encontrada(s)</p>
      {{#each pendentes}}
        <article class="empresa-card-admin">
          <h3>{{nome}}</h3><p>{{email}}</p><span class="badge-parceria">{{tipo_parceria}}</span>
          <div class="botoes-admin">
            <form action="/empresa/aprovar/{{id}}" method="POST"><button class="btn-verde" type="submit">Aprovar</button></form>
            <a href="/empresa/editar/{{id}}" class="btn-branco">Editar</a>
            <form action="/empresa/deletar/{{id}}" method="POST"><button class="btn-vermelho" type="submit">Excluir</button></form>
          </div>
        </article>
      {{else}}<p class="texto-vazio">Nenhuma empresa pendente.</p>{{/each}}
    </section>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Minha empresa | Novacody</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="admin-container">
    <div class="topo-admin">
      <div><h1>{{empresa.nome}}</h1><p class="admin-subtitulo">Painel privado da empresa parceira</p></div>
      <form action="/logout" method="POST"><button class="btn-cancelar" type="submit">Sair</button></form>
    </div>
    {{#if mensagem}}<p role="status">{{mensagem}}</p>{{/if}}
    <section class="form-box">
      <h2>Dados de contato</h2>
      <form action="/minha-empresa/atualizar" method="POST">
        <label>Telefone</label><input name="telefone" value="{{empresa.telefone}}">
        <label>Contato</label><input name="contato" value="{{empresa.contato}}">
        <label>Endereço</label><input name="endereco" value="{{empresa.endereco}}">
        <label>Website</label><input type="url" name="website" value="{{empresa.website}}">
        <label>Descrição das oportunidades</label><textarea name="descricao_vagas">{{empresa.descricao_vagas}}</textarea>
        <label>Observações</label><textarea name="observacoes">{{empresa.observacoes}}</textarea>
        <button class="btn-salvar" type="submit">Salvar dados</button>
      </form>
    </section>
    <section class="form-box">
      <h2>Perfil público</h2>
      <form action="/minha-empresa/perfil" method="POST">
        <label>Descrição institucional</label><textarea name="descricao">{{empresa.perfil.descricao}}</textarea>
        <label>Logotipo (URL)</label><input type="url" name="logotipo" value="{{empresa.perfil.logotipo}}">
        <label>Horário de funcionamento</label><input name="horario_funcionamento" value="{{empresa.perfil.horario_funcionamento}}">
        <button class="btn-salvar" type="submit">Atualizar perfil</button>
      </form>
    </section>
    <section class="form-box">
      <h2>Serviços</h2>
      {{#each empresa.servicos}}
        <article class="empresa-card-admin">
          <form action="/minha-empresa/servicos/{{id}}/editar" method="POST">
            <label>Nome</label><input name="nome" value="{{nome}}" required>
            <label>Descrição</label><textarea name="descricao">{{descricao}}</textarea>
            <label><input type="checkbox" name="ativo" {{#if ativo}}checked{{/if}}> Serviço ativo</label>
            <button class="btn-salvar" type="submit">Atualizar serviço</button>
          </form>
          <form action="/minha-empresa/servicos/{{id}}/excluir" method="POST"><button class="btn-vermelho" type="submit">Excluir</button></form>
        </article>
      {{else}}<p>Nenhum serviço cadastrado.</p>{{/each}}
      <form action="/minha-empresa/servicos" method="POST">
        <label>Nome do serviço</label><input name="nome" required>
        <label>Descrição</label><textarea name="descricao"></textarea>
        <button class="btn-salvar" type="submit">Adicionar serviço</button>
      </form>
    </section>
    <section class="form-box">
      <h2>Avaliações publicadas</h2>
      {{#each empresa.avaliacoes}}<article class="empresa-card-admin"><strong>{{autor}} · {{nota}}/5</strong><p>{{comentario}}</p></article>{{else}}<p>Ainda não há avaliações aprovadas.</p>{{/each}}
    </section>
  </main>
</body>
</html>
